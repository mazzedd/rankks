# RANKKS API — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to git

# ── Database ──────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rankks
DB_USER=postgres
DB_PASSWORD=rankks123

# ── Server ────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Security ──────────────────────────────────────
# Generate a random string for JWT (V2 user auth)
JWT_SECRET=change_this_to_a_random_string_in_production

# ── CORS ──────────────────────────────────────────
# Frontend URL (local dev)
CORS_ORIGIN=http://localhost:5173

# ── Geolocation ───────────────────────────────────
# IP geolocation API (free tier)
GEO_API_URL=http://ip-api.com/json
